        "build": "pnpm -r --filter='./packages/*' run ${npm_lifecycle_event%%:*}",
        "build:indexer": "pnpm -r --filter=./packages/${npm_lifecycle_event##*:} run ${npm_lifecycle_event%%:*}",
        "build:types": "pnpm -r --filter=./packages/${npm_lifecycle_event##*:} run ${npm_lifecycle_event%%:*}",
        "build:utils": "pnpm -r --filter=./packages/${npm_lifecycle_event##*:} run ${npm_lifecycle_event%%:*}",
        "build:watcher": "pnpm -r --filter=./packages/${npm_lifecycle_event##*:} run ${npm_lifecycle_event%%:*}",
        "publish:indexer": "pnpm --filter=./packages/${npm_lifecycle_event##*:} ${npm_lifecycle_event%%:*}",
        "publish:types": "pnpm --filter=./packages/${npm_lifecycle_event##*:} ${npm_lifecycle_event%%:*}",
