        "@typescript-eslint/parser": "^7.0.1",
        "eslint": "^8.56.0",
        "eslint-config-google": "^0.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-security": "^2.1.1",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-html-reporters": "^3.1.7",
